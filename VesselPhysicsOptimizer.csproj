<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>VesselPhysicsOptimizer</AssemblyName>
    <RootNamespace>VesselPhysicsOptimizer</RootNamespace>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <KSPBT_ModRoot>$(MSBuildThisFileDirectory)GameData/VesselPhysicsOptimizer</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
    <KSPBT_InstallCKANDependencies>false</KSPBT_InstallCKANDependencies>
    <KSPBT_GenerateVersionFile>false</KSPBT_GenerateVersionFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>
</Project>